{
  "name": "pico-atlas",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "小图鉴 Pico Atlas — 面向 3–5 岁的「一页一物」图文启蒙应用",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run validate",
    "validate": "tsx tools/validate-content.ts",
    "media:report": "python tools/media_report.py",
    "media:images": ".venv\\Scripts\\python.exe tools/gen_images.py",
    "media:audio": "python tools/gen_audio.py",
    "media:sheet": ".venv\\Scripts\\python.exe tools/contact_sheet.py",
    "review": "node tools/walkthrough.mjs",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "apk": "npm run build:only && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "version": "node tools/bump-version.mjs",
    "release": "npm run version -- patch && npm run apk"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "pinyin-pro": "^3.29.5",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0",
    "zod": "^3.24.1"
  }
}
